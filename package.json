{
  "name": "dsh-wechat-agent-router",
  "version": "0.2.0",
  "description": "按微信群名路由会话 agent：群名（包含 / 精确匹配）→ Agent 预设，零侵入复用 dsh-wechat-assistant 的传输层",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/let-mi-think/wechat-agent-router.git"
  },
  "homepage": "https://github.com/let-mi-think/wechat-agent-router#readme",
  "bugs": {
    "url": "https://github.com/let-mi-think/wechat-agent-router/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "wechat",
    "wechat-assistant",
    "agent-preset",
    "router"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./lib/*.js": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0",
    "dsh": "^0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [
        "react"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-settings": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "build": "tsdown src/client.tsx --format cjs --out-dir .tmp --clean && node --experimental-strip-types scripts/wrap-client.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build"
  }
}
